{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Noptis Studio",
  "version": "1.0.1",
  "identifier": "se.wazabii.noptisstudio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173/noptis-studio/",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Noptis Studio",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
